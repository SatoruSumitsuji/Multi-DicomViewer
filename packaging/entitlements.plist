<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Hardened-runtime entitlements for the notarized macOS build.

      A PyInstaller/CPython app needs these three or it crashes once the
      hardened runtime is enforced:
        * allow-jit + allow-unsigned-executable-memory — CPython and some
          extension modules (and wgpu/Metal shader compilation) allocate
          executable memory / JIT.
        * disable-library-validation — the bundle loads many third-party
          .dylib/.so (PyQt6, VTK-not-on-mac, pygfx/wgpu, numpy, …) that are
          signed with our Developer ID but not by Apple; without this the
          loader rejects them and the app won't launch.
      Keep this list MINIMAL — add an entitlement only when a concrete crash
      proves it's needed.
    -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
